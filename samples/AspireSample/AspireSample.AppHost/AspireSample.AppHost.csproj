<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>528f8cbc-c3c7-4872-b084-c52d4647415b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireSample.Api\AspireSample.Api.csproj" />
    <!-- Labcoat Aspire integration. In your own AppHost: <PackageReference Include="Labcoat.Aspire.Hosting" ... />.
         IsAspireProjectResource=false: this is a library reference, not a project to run as a resource. -->
    <ProjectReference Include="..\..\..\src\Labcoat.Aspire.Hosting\Labcoat.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
