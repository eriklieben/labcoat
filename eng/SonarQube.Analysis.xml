<?xml version="1.0" encoding="utf-8"?>
<!-- The SonarQube Cloud analysis settings, for CI's sonar job and a local run (eng/sonar.mjs): SonarScanner for .NET reads
     them with /s: (it doesn't read sonar-project.properties). docs/releasing.md, "Code analysis", explains each choice. -->
<SonarQubeAnalysisProperties xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">
  <!-- Not shipped: samples, benchmarks, build output, generated code, the mock backend (?mock), the design system
       gallery, build and release scripts, tool configuration. sonar.exclusions only applies to main code; the test
       patterns in it are a guard in case a test file is ever classified as main code. -->
  <Property Name="sonar.exclusions">samples/**,benchmarks/**,artifacts/**,**/wwwroot/**,**/bin/**,**/obj/**,**/*.g.cs,**/node_modules/**,ui/coverage/**,ui/test/**,ui/design-system/test/**,ui/scripts/**,ui/bench/**,**/*.test.ts,**/*.bench.ts,ui/src/mock/**,ui/design-system/gallery/**,eng/**,*.mjs,ui/*.config.ts</Property>
  <Property Name="sonar.coverage.exclusions">eng/**,*.mjs,*.js,ui/*.ts,ui/*.mjs,ui/design-system/*.ts,ui/design-system/gallery/**,ui/src/mock/**,ui/src/main.ts,**/*.d.ts,**/*.css,**/*.html</Property>
  <!-- Theme data: the families repeat the same token blocks on purpose. -->
  <Property Name="sonar.cpd.exclusions">ui/design-system/src/themes/families.ts</Property>
  <Property Name="sonar.cs.cobertura.reportsPaths">artifacts/coverage/raw/*.cobertura.xml</Property>
  <Property Name="sonar.javascript.lcov.reportPaths">ui/coverage/lcov.info</Property>
  <!-- Compiler and analyzer warnings (CA*, MSTEST*, SYSLIB*) are not imported: the build job gates them with
       -warnaserror, and the info-level ones would show up twice (as external issues next to Sonar's own rules). -->
  <Property Name="sonar.cs.roslyn.ignoreIssues">true</Property>

  <!-- Issue ignores: conventions and false positives only, each scoped as narrowly as the scanner allows (the reasons are
       in docs/releasing.md, "Code analysis"). C# ones are [SuppressMessage]s in the code, with their justification. -->
  <Property Name="sonar.issue.ignore.multicriteria">e1,e2,e3,e4,e5,e6,e7,e8,e9</Property>
  <!-- S1444 "public static should be readonly": static defaults / hostClass / observedAttributes on custom elements,
       which subclasses override. -->
  <Property Name="sonar.issue.ignore.multicriteria.e1.ruleKey">typescript:S1444</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e1.resourceKey">ui/**/components/**</Property>
  <!-- S2245 Math.random: confetti animation and reconnect backoff jitter, nothing security-relevant. -->
  <Property Name="sonar.issue.ignore.multicriteria.e2.ruleKey">typescript:S2245</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e2.resourceKey">ui/src/confetti.ts</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e3.ruleKey">typescript:S2245</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e3.resourceKey">ui/src/transport.ts</Property>
  <!-- S4782 "redundant | undefined": the undefined comes from shared aliases (Child, ClassValue, AttrValue,
       MaybeReactive<T | undefined>), not from the property declarations. -->
  <Property Name="sonar.issue.ignore.multicriteria.e4.ruleKey">typescript:S4782</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e4.resourceKey">ui/design-system/src/**</Property>
  <!-- S1874 deprecated execCommand("copy"): the fallback when navigator.clipboard is unavailable (insecure context). -->
  <Property Name="sonar.issue.ignore.multicriteria.e5.ruleKey">typescript:S1874</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e5.resourceKey">ui/design-system/src/components/copy-button.ts</Property>
  <!-- S7758 codePointAt: the project accent hash must keep its values (charCodeAt), or colours would change. -->
  <Property Name="sonar.issue.ignore.multicriteria.e6.ruleKey">typescript:S7758</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e6.resourceKey">ui/src/util.ts</Property>
  <!-- S5906 in a test that compares identity without .not.toBe on purpose (its failure message deep-compares trees). -->
  <Property Name="sonar.issue.ignore.multicriteria.e7.ruleKey">typescript:S5906</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e7.resourceKey">ui/test/app/tree-filter.test.ts</Property>
  <!-- S9423 !important: the motion policy (busy gate, reduced motion, motion off) has to beat every component's and
       every later layer's animation and transition, which is what !important across cascade layers is for. -->
  <Property Name="sonar.issue.ignore.multicriteria.e8.ruleKey">css:S9423</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e8.resourceKey">ui/design-system/src/tokens/motion.css</Property>
  <!-- S9423 !important in .visually-hidden: a hide utility has to win over any later layer's position on the element. -->
  <Property Name="sonar.issue.ignore.multicriteria.e9.ruleKey">css:S9423</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e9.resourceKey">ui/design-system/src/components/dialog.css</Property>
</SonarQubeAnalysisProperties>
