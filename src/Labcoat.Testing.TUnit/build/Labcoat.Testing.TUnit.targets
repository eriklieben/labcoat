<Project>
  <!--
    Labcoat.Testing.TUnit: registers the per-test tracing for the whole test assembly by adding
    [assembly: Labcoat.Testing.LabcoatTracing] (a TUnit test start / end event receiver) to the generated assembly info.
    A no-op unless the tests run under Labcoat with test tracing on.

    <LabcoatTracingFilter>cat:Integration</LabcoatTracingFilter> sets the attribute's Filter: the default trace filter
    of the test assembly (only matching tests are traced; a filter the AppHost passes wins).

    Opt out with <LabcoatTracingAutoRegister>false</LabcoatTracingAutoRegister>, e.g. to put [LabcoatTracing] on some
    classes only, or when GenerateAssemblyInfo is false (then write [assembly: LabcoatTracing] yourself).
  -->
  <ItemGroup Condition="'$(LabcoatTracingAutoRegister)' != 'false'">
    <AssemblyAttribute Include="Labcoat.Testing.LabcoatTracingAttribute" Condition="'$(LabcoatTracingFilter)' == ''" />
    <AssemblyAttribute Include="Labcoat.Testing.LabcoatTracingAttribute" Filter="$(LabcoatTracingFilter)" Condition="'$(LabcoatTracingFilter)' != ''" />
  </ItemGroup>
</Project>
