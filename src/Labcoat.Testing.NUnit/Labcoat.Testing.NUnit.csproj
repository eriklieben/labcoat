<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Loaded into the test application: net8.0 like Labcoat.Testing (NUnit 4 and 5 support net8.0 too). -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Same namespace as Labcoat.Testing: `using Labcoat.Testing;` covers the core and the adapter. -->
    <RootNamespace>Labcoat.Testing</RootNamespace>
    <AssemblyName>Labcoat.Testing.NUnit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Shipped code, not tests: the SonarQube scanner classifies a project that references a test framework as a test
         project (no main-code rules, coverage or lines of code) unless told otherwise. -->
    <SonarQubeTestProject>false</SonarQubeTestProject>

    <IsPackable>true</IsPackable>
    <PackageId>Labcoat.Testing.NUnit</PackageId>
    <Description>NUnit adapter for Labcoat.Testing: per-test OpenTelemetry traces for NUnit + Aspire.Hosting.Testing integration tests on Microsoft.Testing.Platform (Labcoat links each test to its trace and logs in the Aspire dashboard), and live console output in Labcoat while a test runs. Registers itself: no code needed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aspire;testing;nunit;opentelemetry;tracing;integration-testing;microsoft-testing-platform;labcoat</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Labcoat.Testing\Labcoat.Testing.csproj" />
    <PackageReference Include="NUnit" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Labcoat.Testing.NUnit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- build/ (not buildTransitive/): only the project that references the package gets the assembly attribute. -->
    <None Include="build\Labcoat.Testing.NUnit.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
