<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Labcoat</RootNamespace>
    <AssemblyName>Labcoat</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>labcoat</ToolCommandName>
    <EnablePackageValidation>false</EnablePackageValidation>
    <PackageId>Labcoat</PackageId>
    <Description>A web UI for Microsoft.Testing.Platform: browse, run and watch your MSTest, NUnit, xUnit v3 and TUnit tests in the browser, with failure diffs, code coverage per test and run history.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>testing;test-runner;test-explorer;mstest;nunit;xunit;tunit;microsoft-testing-platform;code-coverage;dotnet-tool;aspire;web-ui</PackageTags>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Labcoat.Testing\TraceFilterSyntax.cs" Link="Shared\TraceFilterSyntax.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Labcoat.Tests" />
    <InternalsVisibleTo Include="Labcoat.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\ui\design-system\src\themes\catppuccin.css" LogicalName="Labcoat.Export.theme.css" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Content Update="wwwroot\**" Pack="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(LabcoatUiSbom)' != ''">
    <None Include="$(LabcoatUiSbom)" Link="sbom\ui.cdx.json" CopyToPublishDirectory="PreserveNewest" Pack="false" Visible="false" />
  </ItemGroup>

  <UsingTask TaskName="Microsoft.Sbom.Targets.GenerateSbom" AssemblyFile="$(GenerateSbomTaskAssemblyFilePath)"
             TaskFactory="TaskHostFactory"
             Condition="'$(GenerateSBOM)' == 'true' and '$(GenerateSbomTaskAssemblyFilePath)' != ''" />

  <Target Name="_LabcoatCleanPublishDirForPack" BeforeTargets="PrepareForPublish" Condition="'$(_IsPacking)' == 'true' and '$(PackAsTool)' == 'true'">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>

  <PropertyGroup>
    <LabcoatUiDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../ui'))</LabcoatUiDir>
  </PropertyGroup>
  <Target Name="LabcoatBuildUi" BeforeTargets="PrepareForPublish" Condition="'$(LabcoatBuildUi)' == 'true'"
          Inputs="@(_LabcoatUiSource)" Outputs="$(MSBuildProjectDirectory)/wwwroot/index.html" DependsOnTargets="_LabcoatCollectUiSources">
    <Exec Command="npm ci" WorkingDirectory="$(LabcoatUiDir)" Condition="!Exists('$(LabcoatUiDir)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(LabcoatUiDir)" />
  </Target>
  <Target Name="_LabcoatCollectUiSources">
    <ItemGroup>
      <_LabcoatUiSource Include="$(LabcoatUiDir)/index.html;$(LabcoatUiDir)/package-lock.json;$(LabcoatUiDir)/vite.config.ts;$(LabcoatUiDir)/public/**/*;$(LabcoatUiDir)/src/**/*;$(LabcoatUiDir)/design-system/src/**/*" />
    </ItemGroup>
  </Target>

  <Target Name="_LabcoatRequireUi" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')"
           Text="The UI isn't built (wwwroot/index.html is missing): run 'npm ci &amp;&amp; npm run build' in ui/ (or pack with -p:LabcoatBuildUi=true) before packing." />
  </Target>

</Project>
